# Parul University IPR Portal - Monorepo Environment Template
# Copy to packages/backend/.env and configure values

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
LOG_LEVEL=info

# Application Database Role (ipr_app)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ipr_local_dev
DB_USER=ipr_app
DB_PASSWORD=
DB_SSL=false
# DB_SSL_CA_PATH=

# Dedicated Antivirus Scanner Role (ipr_scanner)
SCANNER_DB_USER=ipr_scanner
SCANNER_DB_PASSWORD=

# Cryptographic & Inter-Service Security
BFF_SHARED_SECRET=
CSRF_SECRET=

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=test-mailer@paruluniversity.ac.in
SMTP_PASSWORD=
